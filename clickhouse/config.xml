<?xml version="1.0"?>
<clickhouse>
    <!-- Basic thread control for 16-core system -->
    <max_thread_pool_size>64</max_thread_pool_size>
    <max_thread_pool_free_size>16</max_thread_pool_free_size>
    
    <!-- Connection and query limits -->
    <max_concurrent_queries>30</max_concurrent_queries>
    <max_connections>200</max_connections>
    
    <!-- Background processing (conservative) -->
    <background_pool_size>8</background_pool_size>
    <background_merges_mutations_concurrency_ratio>2</background_merges_mutations_concurrency_ratio>
    
    <!-- Cache sizes (reasonable for 16-core) -->
    <mark_cache_size>1073741824</mark_cache_size>        <!-- 1GB -->
    <uncompressed_cache_size>536870912</uncompressed_cache_size> <!-- 512MB -->
</clickhouse> 